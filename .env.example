# Firebase Configuration (Web Client)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
# Web Push (FCM): Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here

# Cloudinary (file/image uploads — KYC docs, vehicle photos, avatars)
# Uploads are signed by the backend; keep the API secret server-side
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payments & Route Split Payouts
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Backend API base URL
# Leave empty — in dev Rsbuild proxies /api/* to localhost:5000, and in production
# Azure App Service serves both the frontend and /api/* from the same origin.
VITE_API_BASE_URL=
PORT=5000

# Optional local dev portal override ('customer' or 'vendor')
# Production detects domain automatically: fleetmobilities.in (customer) vs fleetmobilities.info (vendor)
# VITE_PORTAL_MODE=customer

# Firebase Admin configuration
# Set FIREBASE_SERVICE_ACCOUNT_BASE64 in Azure App Service environment variables,
# or GOOGLE_APPLICATION_CREDENTIALS=./service-account.json for local development.
FIREBASE_PROJECT_ID=fleetmobilities-3ee31
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://fleetmobilities.in,https://www.fleetmobilities.in,https://fleetmobilities.info,https://www.fleetmobilities.info
